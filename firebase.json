{
    "hosting": {
        "target": "kflow-assets",
        "public": ".",
        "ignore": [
            "firebase.json",
            ".firebaserc",
            "**/.*",
            "**/*.md",
            "scripts/**"
        ],
        "headers": [
            {
                "source": "**/*.@(png|jpg|jpeg|webp|svg|gif)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=3600, stale-while-revalidate=86400"
                    },
                    {
                        "key": "Access-Control-Allow-Origin",
                        "value": "*"
                    }
                ]
            },
            {
                "source": "**/*.@(mp3|ogg|wav)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=3600, stale-while-revalidate=86400"
                    },
                    {
                        "key": "Access-Control-Allow-Origin",
                        "value": "*"
                    }
                ]
            },
            {
                "source": "**/*.@(glb|gltf)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=3600, stale-while-revalidate=86400"
                    },
                    {
                        "key": "Access-Control-Allow-Origin",
                        "value": "*"
                    }
                ]
            },
            {
                "source": "**/*.json",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=3600"
                    },
                    {
                        "key": "Access-Control-Allow-Origin",
                        "value": "*"
                    }
                ]
            },
            {
                "source": "**/*.@(ttf|otf|woff|woff2)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=86400, stale-while-revalidate=604800"
                    },
                    {
                        "key": "Access-Control-Allow-Origin",
                        "value": "*"
                    }
                ]
            }
        ]
    }
}
